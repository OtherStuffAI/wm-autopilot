{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.js",
      "clis/**/*.ts",
      "scripts/**/*.ts",
      "scripts/**/*.js",
      "*.ts",
      "*.js",
      "!scripts/isolated-test",
      "!public",
      "!out",
      "!data",
      "!tmp"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnsafeOptionalChaining": "warn"
      },
      "suspicious": {
        "noDebugger": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2,
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
