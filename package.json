    "@tiptap/starter-kit": "^3.30.1",
    "@types/js-yaml": "^4.0.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ace-builds": "^1.44.0",
    "alpinejs": "^3.16.1",
    "applesauce-core": "^4.4.2",
    "applesauce-relay": "^4.4.2",
    "applesauce-signers": "^4.2.0",
