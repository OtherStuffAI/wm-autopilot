  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "ajv": "8.20.0",
    "basic-ftp": "6.2.0",
    "body-parser": "2.3.0",
    "dompurify": "3.4.14",
    "express-rate-limit": "8.6.2",
