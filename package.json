{
  "name": "wingman-v2",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "bun run scripts/install-agentapi-loopback.ts",
    "start": "bun run src/index.ts",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --project tsconfig.release.json",
    "appctl": "bun run scripts/wingman-appctl.ts",
    "cli:apps": "bun clis/appctl.ts",
    "cli:delegate-sessions": "bun clis/delegate-sessions.ts",
    "cli:sessions": "bun clis/sessions.ts",
    "cli:session-tags": "bun clis/session-tags.ts",
    "cli:workroom-integrator": "bun clis/workroom-integrator.ts",
    "cli:sign": "bun clis/wingman-sign.ts",
    "cli:wingman": "bun clis/wingman.ts",
    "cli:capability": "bun clis/wingman-capability.ts",
    "cli:status": "bun clis/status.ts",
    "cli:deploy": "bun clis/deploy.ts",
    "build:bunker-client": "bun build src/ui/identity/bunker-client.ts --target browser --outfile public/vendor/bunker-client.js",
    "build:agentapi-loopback": "bun run scripts/build-agentapi-loopback.ts",
    "build:tiptap-bundle": "bun build src/ui/tiptap/vendor-bundle.ts --target browser --format esm --outfile public/vendor/tiptap-bundle.js",
    "cleanports": "bun run scripts/clean-ports.ts",
    "docker:check": "bun run scripts/docker-readiness.ts",
    "docker:provision": "bun run scripts/provision-docker-instance.ts",
    "quality:public-source": "bun run scripts/check-public-source.ts",
    "security:audit": "bun run scripts/security-audit.ts",
    "security:agentapi-listener": "bun run scripts/verify-agentapi-loopback.ts",
    "security:pm2-metadata": "bun run scripts/pm2-secret-metadata-report.ts",
    "runtime:backup": "bun scripts/runtime-backup.ts",
    "apps:migrate-registry": "bun scripts/migrate-app-registry.ts"
  },
  "dependencies": {
