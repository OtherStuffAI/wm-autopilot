diff --git a/lib/msgfmt/codex_message_box_test.go b/lib/msgfmt/codex_message_box_test.go
new file mode 100644
index 0000000..1bcb1f7
--- /dev/null
+++ b/lib/msgfmt/codex_message_box_test.go
@@ -0,0 +1,22 @@
+package msgfmt
+
+import "testing"
+
+func TestCodexInitialPromptReadyAcrossComposerLayouts(t *testing.T) {
+	cases := []struct {
+		name   string
+		screen string
+		ready  bool
+	}{
+		{"older", "Codex ready\n› Refactor this Code...\ngpt-5.1-codex-max default · ~/repo", true},
+		{"newer", "Codex ready\n\n› Ask Codex to do anything\n\nGPT-6-Sol medium · ~/repo\n? for shortcuts ⚠ 3 warnings", true},
+		{"working", "Codex ready\n› Ask Codex to do anything\nWorking on the current turn", false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := IsAgentReadyForInitialPrompt(AgentTypeCodex, tc.screen); got != tc.ready {
+				t.Fatalf("readiness = %t, want %t", got, tc.ready)
+			}
+		})
+	}
+}
